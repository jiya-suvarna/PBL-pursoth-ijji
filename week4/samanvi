/* ---------- UI HELPERS ---------- */

static GtkWidget *make_label(const char *text)
{
    GtkWidget *label = gtk_label_new(text);
    gtk_widget_set_halign(label, GTK_ALIGN_START);
    return label;
}

static GtkWidget *make_button(const char *text)
{
    GtkWidget *button = gtk_button_new_with_label(text);
    gtk_widget_set_size_request(button, 125, 36);
    return button;
}

static void set_status(const char *text)
{
    gtk_label_set_text(GTK_LABEL(status_label), text);
}

static GtkWidget *create_grid(void)
{
    GtkWidget *grid = gtk_grid_new();
    gtk_grid_set_row_spacing(GTK_GRID(grid), 6);
    gtk_grid_set_column_spacing(GTK_GRID(grid), 8);
    gtk_container_set_border_width(GTK_CONTAINER(grid), 8);
    return grid;
}

static void clear_grid(GtkWidget *grid)
{
    GList *children =
        gtk_container_get_children(GTK_CONTAINER(grid));

    for (GList *item = children; item != NULL; item = item->next)
        gtk_widget_destroy(GTK_WIDGET(item->data));

    g_list_free(children);
}

/* ---------- BUILD INPUT FORMS ---------- */

static void build_input_fields(void)
{
    char text[32];

    P = gtk_spin_button_get_value_as_int(
        GTK_SPIN_BUTTON(process_spin));

    R = gtk_spin_button_get_value_as_int(
        GTK_SPIN_BUTTON(resource_spin));

    clear_grid(allocation_grid);
    clear_grid(maximum_grid);
    clear_grid(available_grid);

    /* Column headings */
    for (int j = 0; j < R; j++)
    {
        snprintf(text, sizeof(text), "R%d", j);
        gtk_grid_attach(GTK_GRID(allocation_grid),
                        make_label(text), j + 1, 0, 1, 1);
        gtk_grid_attach(GTK_GRID(maximum_grid),
                        make_label(text), j + 1, 0, 1, 1);
        gtk_grid_attach(GTK_GRID(available_grid),
                        make_label(text), j, 0, 1, 1);
    }

    /* Process rows and editable matrix fields */
    for (int i = 0; i < P; i++)
    {
        snprintf(text, sizeof(text), "P%d", i);
        gtk_grid_attach(GTK_GRID(allocation_grid),
                        make_label(text), 0, i + 1, 1, 1);
        gtk_grid_attach(GTK_GRID(maximum_grid),
                        make_label(text), 0, i + 1, 1, 1);

        for (int j = 0; j < R; j++)
        {
            alloc_entries[i][j] = gtk_entry_new();
            max_entries[i][j] = gtk_entry_new();

            gtk_entry_set_width_chars(
                GTK_ENTRY(alloc_entries[i][j]), 5);
            gtk_entry_set_width_chars(
                GTK_ENTRY(max_entries[i][j]), 5);

            gtk_entry_set_input_purpose(
                GTK_ENTRY(alloc_entries[i][j]),
                GTK_INPUT_PURPOSE_DIGITS);
            gtk_entry_set_input_purpose(
                GTK_ENTRY(max_entries[i][j]),
                GTK_INPUT_PURPOSE_DIGITS);

            gtk_entry_set_text(
                GTK_ENTRY(alloc_entries[i][j]), "0");
            gtk_entry_set_text(
                GTK_ENTRY(max_entries[i][j]), "0");

            gtk_grid_attach(GTK_GRID(allocation_grid),
                            alloc_entries[i][j],
                            j + 1, i + 1, 1, 1);
            gtk_grid_attach(GTK_GRID(maximum_grid),
                            max_entries[i][j],
                            j + 1, i + 1, 1, 1);
        }
    }

    /* Available vector fields */
    for (int j = 0; j < R; j++)
    {
        avail_entries[j] = gtk_entry_new();
        gtk_entry_set_width_chars(
            GTK_ENTRY(avail_entries[j]), 5);
        gtk_entry_set_input_purpose(
            GTK_ENTRY(avail_entries[j]),
            GTK_INPUT_PURPOSE_DIGITS);
        gtk_entry_set_text(GTK_ENTRY(avail_entries[j]), "0");

        gtk_grid_attach(GTK_GRID(available_grid),
                        avail_entries[j], j, 1, 1, 1);
    }

    data_loaded = FALSE;

    gtk_text_buffer_set_text(
        gtk_text_view_get_buffer(GTK_TEXT_VIEW(need_view)),
        "Enter resource values, then click Calculate Need.",
        -1);

    gtk_widget_show_all(window);
    set_status("Ready | Enter resource data");
}

/* ---------- VALIDATE INPUT ---------- */

static gboolean read_entry(GtkWidget *entry, int *value)
{
    const char *text =
        gtk_entry_get_text(GTK_ENTRY(entry));
    char *end;
    long number;

    if (text[0] == '\0')
        return FALSE;

    number = strtol(text, &end, 10);

    if (*end != '\0' || number < 0 || number > 1000000)
        return FALSE;

    *value = (int)number;
    return TRUE;
}

static gboolean collect_data(void)
{
    for (int i = 0; i < P; i++)
    {
        for (int j = 0; j < R; j++)
        {
            if (!read_entry(alloc_entries[i][j],
                            &allocation[i][j]) ||
                !read_entry(max_entries[i][j],
                            &maximum[i][j]))
            {
                set_status("Error | Enter valid non-negative integers");
                return FALSE;
            }

            if (maximum[i][j] < allocation[i][j])
            {
                set_status("Error | Maximum must be >= Allocation");
                return FALSE;
            }

            need[i][j] =
                maximum[i][j] - allocation[i][j];
        }
    }

    for (int j = 0; j < R; j++)
    {
        if (!read_entry(avail_entries[j], &available[j]))
        {
            set_status("Error | Invalid Available Vector");
            return FALSE;
        }
    }

    data_loaded = TRUE;
    return TRUE;
}

/* ---------- DISPLAY OUTPUT ---------- */

static void show_output(const char *text)
{
    gtk_text_buffer_set_text(
        gtk_text_view_get_buffer(GTK_TEXT_VIEW(need_view)),
        text, -1);
}

static void on_calculate(GtkButton *button, gpointer data)
{
    (void)button;
    (void)data;

    if (!collect_data())
        return;

    char output[8192];
    int used = 0;

    used += snprintf(output + used, sizeof(output) - used,
                     "NEED MATRIX\nNeed = Maximum - Allocation\n\n");

    for (int i = 0; i < P && used < (int)sizeof(output); i++)
    {
        used += snprintf(output + used, sizeof(output) - used,
                         "P%d: ", i);

        for (int j = 0; j < R && used < (int)sizeof(output); j++)
            used += snprintf(output + used,
                             sizeof(output) - used,
                             "%d  ", need[i][j]);

        used += snprintf(output + used,
                         sizeof(output) - used, "\n");
    }

    show_output(output);
    set_status("Success | Input validated; Need Matrix calculated");
}

static void on_view_matrices(GtkButton *button, gpointer data)
{
    (void)button;
    (void)data;

    if (!data_loaded && !collect_data())
        return;

    char output[8192];
    int used = 0;

    for (int matrix = 0; matrix < 3; matrix++)
    {
        const char *title =
            matrix == 0 ? "ALLOCATION MATRIX" :
            matrix == 1 ? "MAXIMUM MATRIX" : "NEED MATRIX";

        int (*values)[MAX_R] =
            matrix == 0 ? allocation :
            matrix == 1 ? maximum : need;

        used += snprintf(output + used, sizeof(output) - used,
                         "%s\n", title);

        for (int i = 0; i < P && used < (int)sizeof(output); i++)
        {
            used += snprintf(output + used,
                             sizeof(output) - used, "P%d: ", i);

            for (int j = 0; j < R &&
                 used < (int)sizeof(output); j++)
                used += snprintf(output + used,
                                 sizeof(output) - used,
                                 "%d  ", values[i][j]);

            used += snprintf(output + used,
                             sizeof(output) - used, "\n");
        }

        used += snprintf(output + used,
                         sizeof(output) - used, "\n");
    }

    used += snprintf(output + used, sizeof(output) - used,
                     "AVAILABLE RESOURCE VECTOR\n");

    for (int j = 0; j < R && used < (int)sizeof(output); j++)
        used += snprintf(output + used,
                         sizeof(output) - used,
                         "R%d = %d   ", j, available[j]);

    show_output(output);
    set_status("All matrices displayed");
}

