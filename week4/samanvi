static void on_sample(GtkButton *button, gpointer data)
{
    (void)button;
    (void)data;

    gtk_spin_button_set_value(GTK_SPIN_BUTTON(process_spin), 3);
    gtk_spin_button_set_value(GTK_SPIN_BUTTON(resource_spin), 3);

    build_input_fields();

    int a[3][3] = {{1, 0, 1}, {1, 1, 0}, {0, 1, 1}};
    int m[3][3] = {{2, 1, 1}, {1, 2, 1}, {1, 1, 2}};
    int v[3] = {1, 1, 1};
    char text[24];

    for (int i = 0; i < 3; i++)
    {
        for (int j = 0; j < 3; j++)
        {
            snprintf(text, sizeof(text), "%d", a[i][j]);
            gtk_entry_set_text(
                GTK_ENTRY(alloc_entries[i][j]), text);

            snprintf(text, sizeof(text), "%d", m[i][j]);
            gtk_entry_set_text(
                GTK_ENTRY(max_entries[i][j]), text);
        }
    }

    for (int j = 0; j < 3; j++)
    {
        snprintf(text, sizeof(text), "%d", v[j]);
        gtk_entry_set_text(GTK_ENTRY(avail_entries[j]), text);
    }

    if (collect_data())
        set_status("Sample data loaded successfully");
}

static void on_reset(GtkButton *button, gpointer data)
{
    (void)button;
    (void)data;

    build_input_fields();
    show_output("Data reset. Enter new resource values.");
    set_status("Reset complete | No data loaded");
}

static void on_simulate(GtkButton *button, gpointer data)
{
    (void)button;
    (void)data;

    int safeSequence[20];
    int safe;
    char output[2048];
    int pos = 0;

    int deadlockedProcesses[20];
    int completionOrder[20];
    int deadlockedCount = 0;
    int completionCount = 0;
    int noDeadlock;

    if (!data_loaded && !collect_data())
        return;

    int total[20];

for (int j = 0; j < R; j++)
{
    total[j] = available[j];

    for (int i = 0; i < P; i++)
        total[j] += allocation[i][j];
}
prepare_resource_state(
    &resource_state,
    P,
    R,
    total,
    allocation,
    maximum
);

    double utilization[20];

    for (int j = 0; j < R; j++)
    {
        int allocated = total[j] - available[j];

        if (total[j] > 0)
            utilization[j] =
                ((double)allocated / total[j]) * 100.0;
        else
            utilization[j] = 0.0;
    }

        safe = run_banker_from_gui(
        P,
        R,
        allocation,
        maximum,
        available,
        safeSequence
    );

    noDeadlock = run_deadlock_detection_from_gui(
    P,
    R,
    allocation,
    need,
    available,
    deadlockedProcesses,
    completionOrder,
    &deadlockedCount,
    &completionCount
);

    pos += snprintf(output + pos, sizeof(output) - pos,
                    "RESOURCE UTILIZATION\n\n");

    for (int j = 0; j < R; j++)
    {
        pos += snprintf(output + pos, sizeof(output) - pos,
                        "R%d: %.2f%%\n",
                        j + 1,
                        utilization[j]);
    }

    pos += snprintf(output + pos, sizeof(output) - pos, "\n");
    pos += snprintf(output + pos, sizeof(output) - pos,
                    "BANKER'S ALGORITHM RESULT\n\n");

    if (safe)
    {
        pos += snprintf(output + pos, sizeof(output) - pos,
                        "System State: SAFE\n\n");

        pos += snprintf(output + pos, sizeof(output) - pos,
                        "Safe Sequence: ");

        for (int i = 0; i < P; i++)
        {
            pos += snprintf(output + pos, sizeof(output) - pos,
                            "P%d", safeSequence[i]);

            if (i < P - 1)
                pos += snprintf(output + pos, sizeof(output) - pos,
                                " -> ");
        }

        pos += snprintf(output + pos, sizeof(output) - pos, "\n");
        set_status("Banker's Algorithm | SAFE");
    }
    else
    {
        pos += snprintf(output + pos, sizeof(output) - pos,
                        "System State: UNSAFE\n\n");

        pos += snprintf(output + pos, sizeof(output) - pos,
                        "No safe sequence exists.\n");

        set_status("Banker's Algorithm | UNSAFE");
    }
pos += snprintf(output + pos, sizeof(output) - pos,
                "\nDEADLOCK DETECTION RESULT\n\n");

if (noDeadlock)
{
    pos += snprintf(output + pos, sizeof(output) - pos,
                    "Result: No deadlock detected.\n");

    if (completionCount > 0)
    {
        pos += snprintf(output + pos, sizeof(output) - pos,
                        "Completion Order: ");

        for (int i = 0; i < completionCount; i++)
        {
            pos += snprintf(output + pos, sizeof(output) - pos,
                            "P%d",
                            completionOrder[i] + 1);

            if (i < completionCount - 1)
                pos += snprintf(output + pos, sizeof(output) - pos,
                                " -> ");
        }

        pos += snprintf(output + pos, sizeof(output) - pos, "\n");
    }
}
else
{
    pos += snprintf(output + pos, sizeof(output) - pos,
                    "Result: DEADLOCK DETECTED!\n");

    pos += snprintf(output + pos, sizeof(output) - pos,
                    "Affected Processes: ");

    for (int i = 0; i < deadlockedCount; i++)
    {
        pos += snprintf(output + pos, sizeof(output) - pos,
                        "P%d",
                        deadlockedProcesses[i] + 1);

        if (i < deadlockedCount - 1)
            pos += snprintf(output + pos, sizeof(output) - pos,
                            ", ");
    }

    pos += snprintf(output + pos, sizeof(output) - pos, "\n");
}
    show_output(output);
}

static void on_view_rag(GtkButton *button, gpointer data)
{
    (void)button;
    (void)data;

    if (!data_loaded && !collect_data())
        return;

    int deadlockedProcesses[20];
    int completionOrder[20];
    int deadlockedCount = 0;
    int completionCount = 0;

    int noDeadlock = run_deadlock_detection_from_gui(
        P,
        R,
        allocation,
        need,
        available,
        deadlockedProcesses,
        completionOrder,
        &deadlockedCount,
        &completionCount
    );

    int ragCreated = run_rag_from_gui(
        P,
        R,
        allocation,
        need,
        deadlockedProcesses,
        deadlockedCount
    );

    if (!ragCreated)
    {
        show_output("Failed to create Resource Allocation Graph.");
        set_status("RAG creation failed");
        return;
    }

    show_output(
        "RESOURCE ALLOCATION GRAPH\n\n"
        "RAG generated successfully.\n\n"
        "File: rag.dot\n"
        "Visualization: rag.png"
    );

    set_status("RAG generated successfully");
}

/* ---------- DEADLOCK RECOVERY ---------- */

static void on_recover(GtkButton *button, gpointer data)
{
    (void)button;
    (void)data;

    if (!data_loaded && !collect_data())
        return;

    int deadlockedProcesses[20];
    int completionOrder[20];
    int deadlockedCount = 0;
    int completionCount = 0;

    /* Detect deadlock using the current GUI data */
    int noDeadlock = run_deadlock_detection_from_gui(
        P,
        R,
        allocation,
        need,
        available,
        deadlockedProcesses,
        completionOrder,
        &deadlockedCount,
        &completionCount
    );

    if (noDeadlock || deadlockedCount == 0)
    {
        show_output(
            "No deadlock detected.\n\n"
            "Recovery is not required."
        );

        set_status("No deadlock | Recovery not required");
        return;
    }

    /* Recover the first deadlocked process */
    int process = deadlockedProcesses[0];

    int recovered = run_deadlock_recovery_from_gui(
        P,
        R,
        allocation,
        need,
        available,
        process
    );

    if (!recovered)
    {
        show_output("Recovery failed.");
        set_status("Recovery failed");
        return;
    }

    char output[1024];
    int pos = 0;

    pos += snprintf(
        output + pos,
        sizeof(output) - pos,
        "DEADLOCK RECOVERY RESULT\n\n"
        "Terminated Process: P%d\n"
        "Resources released successfully.\n\n",
        process + 1
    );

    pos += snprintf(
        output + pos,
        sizeof(output) - pos,
        "Updated Available Resources: "
    );

    for (int j = 0; j < R; j++)
    {
        pos += snprintf(
            output + pos,
            sizeof(output) - pos,
            "%d",
            available[j]
        );

        if (j < R - 1)
            pos += snprintf(
                output + pos,
                sizeof(output) - pos,
                " "
            );
    }

    pos += snprintf(
        output + pos,
        sizeof(output) - pos,
        "\n"
    );

    show_output(output);
    set_status("Deadlock recovered successfully");
}
