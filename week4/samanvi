    gtk_text_view_set_monospace(GTK_TEXT_VIEW(need_view), TRUE);
    gtk_text_view_set_wrap_mode(GTK_TEXT_VIEW(need_view),
                                GTK_WRAP_WORD_CHAR);

    gtk_text_buffer_set_text(
        gtk_text_view_get_buffer(GTK_TEXT_VIEW(need_view)),
        "Click Load Sample Data or enter resource values.",
        -1);

    GtkWidget *scroll =
        gtk_scrolled_window_new(NULL, NULL);
    gtk_scrolled_window_set_policy(
        GTK_SCROLLED_WINDOW(scroll),
        GTK_POLICY_AUTOMATIC, GTK_POLICY_AUTOMATIC);

    gtk_container_add(GTK_CONTAINER(scroll), need_view);
    gtk_container_add(GTK_CONTAINER(result_frame), scroll);

    /* System status */
    status_label = gtk_label_new("Ready | Enter resource data");
    gtk_widget_set_halign(status_label, GTK_ALIGN_START);
    gtk_box_pack_start(GTK_BOX(root),
        status_label, FALSE, FALSE, 5);

    build_input_fields();

    gtk_widget_show_all(window);
    gtk_main();

    return 0;
}
